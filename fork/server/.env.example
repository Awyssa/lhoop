# Copy this file to .env and fill it in. .env is never committed.

# The SHA-256 of the token, never the token itself. Both are printed by:
#   docker compose run --rm api token new
LHOOP_TOKEN_SHA256=

# Only with compose.caddy.yaml: the name the server answers on. Where another Caddy already runs,
# the name goes in that Caddy's own file and this line is not used.
LHOOP_HOST=backup.example.com
