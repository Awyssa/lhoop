<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's one use of the network is the backup to the owner's server, and that is HTTPS only: the
  data is health data and the request carries the token. Plain HTTP is refused by the platform here,
  as well as by the app's own check of the address (fork.app.backup.BackupAddress).

  Debug builds have their own copy of this file (src/debug), which lets an emulator reach a server
  under test on the machine it runs on.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
