<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork-only (lhoop-staging): debug builds are the testing/staging app. The package is already
  com.lhoop.whoop.debug (debug applicationIdSuffix), so it installs ALONGSIDE the official LHOOP
  (com.lhoop.whoop) with its own data. This override gives it a distinct launcher name so the two
  are tellable apart on the home screen. Build-type source set wins over main/flavor, so
  assembleFullDebug shows "LHOOP Staging". Mirrors how the demo flavor labels itself "LHOOP Demo".
-->
<resources>
    <string name="app_name">LHOOP Staging</string>
</resources>
